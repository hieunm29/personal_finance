# ═══════════════════════════════════════════════════════════
# Database — SQLite local file
# ═══════════════════════════════════════════════════════════
DATABASE_URL=file:./data/app.db

# ═══════════════════════════════════════════════════════════
# Auth — better-auth (đổi secret trong production!)
# ═══════════════════════════════════════════════════════════
BETTER_AUTH_SECRET=your-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════
# Frontend (Vite — bắt buộc prefix VITE_)
# ═══════════════════════════════════════════════════════════
VITE_API_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════
# AI Assistant (Claude) — xem doc/7.ai_assistant_architecture.md
# ═══════════════════════════════════════════════════════════
AI_ENABLED=1
# anthropic | openrouter
AI_PROVIDER=openrouter
# Dùng khi AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Dùng khi AI_PROVIDER=openrouter — lấy tại https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Tên model theo provider. Bỏ trống = mặc định:
#   anthropic  → claude-opus-5-5
#   openrouter → anthropic/claude-opus-5.5   (rẻ hơn: anthropic/claude-haiku-5.5 — kiểm tra slug trên openrouter.ai/models)
AI_MODEL=
# low | medium | high — chỉ áp dụng khi AI_PROVIDER=anthropic
AI_EFFORT=low
# Số tin nhắn gần nhất gửi lại cho AI làm "trí nhớ"
AI_HISTORY_LIMIT=20

# ═══════════════════════════════════════════════════════════
# Zalo Bot Platform — tạo bot tại https://bot.zaloplatforms.com
# ═══════════════════════════════════════════════════════════
ZALO_BOT_TOKEN=
ZALO_API_BASE=https://bot-api.zaloplatforms.com
# Chuỗi ngẫu nhiên ≥ 8 ký tự; Zalo gửi lại trong header X-Bot-Api-Secret-Token
ZALO_WEBHOOK_SECRET=
# URL public trỏ về server (ngrok/cloudflared khi dev; production = https://<APP_DOMAIN>)
PUBLIC_BASE_URL=

# ═══════════════════════════════════════════════════════════
# Production (docker compose — xem doc/deploy-oracle.md)
# Trên VM: đổi BETTER_AUTH_URL / FRONTEND_URL / PUBLIC_BASE_URL thành https://<APP_DOMAIN>
# (cùng một địa chỉ cho cả ba, vì web và API chung một origin), bỏ trống VITE_API_URL.
# ═══════════════════════════════════════════════════════════
# Tên miền trỏ về VM (A record); Caddy tự cấp HTTPS cho tên này
APP_DOMAIN=

# ═══════════════════════════════════════════════════════════
# Sao lưu hằng ngày — bản trên máy chủ nằm ở /app/backups (volume `backups`).
# Có đủ R2_* thì mỗi bản còn được đẩy lên Cloudflare R2 (bucket private, API token chỉ cho bucket này).
# ═══════════════════════════════════════════════════════════
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Sao lưu chỉ bật khi NODE_ENV=production. BACKUP_ENABLED=1 để ép bật ở dev, =0 để tắt ở production.
BACKUP_ENABLED=
# Mặc định: thư mục `backups` nằm cạnh thư mục chứa file DB (production: /app/backups)
BACKUP_DIR=
